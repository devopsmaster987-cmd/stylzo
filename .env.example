# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=3000
SITE_URL=http://localhost:3000
MAX_INPUT_LENGTH=5000
RATE_LIMIT_PER_MINUTE=60
# Shown on /contact only when set
CONTACT_EMAIL=

# Official profile URLs for this brand, comma separated. Emitted as `sameAs` on
# the Organization node, which is what lets an answer engine tie a claim about
# the site to an account it already knows. Only list profiles this site owns:
# pointing sameAs at someone else's account is a claim about their identity.
# Non-https entries are ignored. Leave blank to omit the property entirely.
SAME_AS=

# M7 - open /admin?key=<this> on your deployment (optional but recommended)
ADMIN_KEY=

# M9 - Google AdSense. Public identifiers, not secrets. With both set, the ad
# tag, ad slots, public/ads.txt and the consent banner all switch on. Without
# them the site renders exactly as it does now, with no ad-shaped gaps.
# Find both in your AdSense account: Account > Settings > Account information.
ADSENSE_CLIENT=
ADSENSE_SLOT=

# Set to 1 only after a Google-certified CMP is published in AdSense >
# Privacy & messaging. This hides the site's own banner and lets AdSense's CMP
# own consent for EEA/UK/CH visitors. Leave at 0 until that is live.
CERTIFIED_CMP=0

# M7 - optional model provider for the AI stylist (falls back to the local rules engine)
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# M6 - optional Firebase web config. Without these the app stays in local mode
# (favourites and recents live in localStorage, no sign-in button). There is no
# /account route; Firebase is only read by /api/config and /admin.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
